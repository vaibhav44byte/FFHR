<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg_gradient"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Fertilizer &amp; Pesticide Calculator"
            android:textColor="#04b31b"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spCrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Crop selection" />

        <Spinner
            android:id="@+id/spCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:contentDescription="Category selection" />

        <Spinner
            android:id="@+id/spProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:contentDescription="Product selection" />

        <EditText
            android:id="@+id/etArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:autofillHints="none"
            android:hint="Enter area"
            android:inputType="numberDecimal" />

        <Spinner
            android:id="@+id/spAreaUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:contentDescription="Area unit selection" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbBroadcast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Per Area Dose" />

            <RadioButton
                android:id="@+id/rbSpray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Spray Mix" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvDoseHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Dose hint will appear here"
            android:textColor="#444444"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etDoseValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="none"
            android:hint="Enter dose"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etTankSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:autofillHints="none"
            android:hint="Tank size (liters)"
            android:inputType="numberDecimal"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etSprayVolumePerAcre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:autofillHints="none"
            android:hint="Spray volume per acre (liters)"
            android:inputType="numberDecimal"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#04b31b"
            android:text="Calculate"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#EAF8EC"
            android:padding="12dp"
            android:text="Result will appear here"
            android:textColor="#1F1F1F"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
