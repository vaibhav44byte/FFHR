<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF"
    android:gravity="center">

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="170dp"
        android:layout_height="51dp"
        android:layout_marginBottom="0dp"
        android:contentDescription="SoilSathi Logo"
        android:src="@drawable/logo" />

    <TextView
        android:id="@+id/logotext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Reset Password"
        android:textColor="#04b31b"
        android:textSize="30sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:text="Enter your registered email and we will send you a password reset link."
        android:textColor="#222222"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter registered email"
        android:inputType="textEmailAddress" />

    <Button
        android:id="@+id/btnSendOtp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="100dp"
        android:backgroundTint="#04b31b"
        android:text="Send Reset Link" />
</LinearLayout>
